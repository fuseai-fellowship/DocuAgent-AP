   "source": [
    "### Layout test using PP-DocLayout_plus-L"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "70554ca9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import time \n",
    "import os \n",
    "from pathlib import Path\n",
    "from paddleocr import LayoutDetection\n",
    "# Add the src directory to the Python path\n",
    "OUTPUT = \"../outputs\"\n",
    "\n",
    "layout_model = LayoutDetection(model_name=\"PP-DocLayout_plus-L\")\n",
    "\n",
    "\n",
    "image_path = Path(\"data/page_1.png\")\n",
    "output_folder = Path(OUTPUT) / \"layout\"\n",
    "os.makedirs(output_folder, exist_ok=True)\n",
    "before = time.time()\n",
    "if image_path.exists():\n",
    "    output = layout_model.predict(str(image_path))  \n",
    "    after = time.time()\n",
    "    for res in output:\n",
    "        res.print()\n",
    "        res.save_to_img(Path(OUTPUT) / \"layout\")\n",
    "        res.save_to_json(Path(OUTPUT) / \"layout\")\n",
    "    print(f\"Processed {image_path} in {after - before:.2f} seconds\")\n",
    "else:\n",
    "    print(f\"Error: The file {image_path} does not exist.\")\n"
   ]
  }
