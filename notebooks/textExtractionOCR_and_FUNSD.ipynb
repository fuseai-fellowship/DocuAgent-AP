   "source": [
    "🔹 Step 2. Get Ground Truth from FUNSD\n",
    "\n",
    "FUNSD provides JSON annotations per image. Each has text + bounding boxes.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9869b1e4-91b2-439f-afdd-80c4beafee69",
   "metadata": {
    "id": "a51a1e04"
   },
   "outputs": [],
   "source": [
    "def extract_ground_truth(annotations):\n",
    "    ground_truth = []\n",
    "    for form_field in annotations[\"form\"]:\n",
    "        for word in form_field[\"words\"]:\n",
    "            ground_truth.append({\n",
    "                \"text\": word[\"text\"],\n",
    "                \"bbox\": word[\"box\"]\n",
    "            })\n",
    "    return ground_truth"
   ]
  },
